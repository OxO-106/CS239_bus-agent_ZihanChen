Allow(Q) :- Request(Q, "share", "update_share"),
    Parameter(Q, "share_id", S),
    Parameter(Q, "message", _),
    Parameter(Q, "eta_time", E),
    E != "",
    Field(_, "eta_value", E),
    CanTransition(S, "update_share", "active", "active").

Allow(Q) :- Request(Q, "share", "update_share"),
    Parameter(Q, "share_id", S),
    Parameter(Q, "message", _),
    Parameter(Q, "eta_time", ""),
    CanTransition(S, "update_share", "active", "active").

Allow(Q) :- Request(Q, "app", "update_share"),
    Parameter(Q, "share_id", S),
    Parameter(Q, "message", _),
    Parameter(Q, "eta_time", E),
    E != "",
    Field(_, "eta_value", E),
    CanTransition(S, "update_share", "active", "active").

