    CanTransition(S, "update_share", "active", "active").

Allow(Q) :- Request(Q, "share", "revoke_share"),
    Parameter(Q, "share_id", S),
    CanTransition(S, "revoke_share", "active", "revoked").

Allow(Q) :- Request(Q, "app", "revoke_share"),
    Parameter(Q, "share_id", S),
    CanTransition(S, "revoke_share", "active", "revoked").

Allow(Q) :- Request(Q, "share", "send_message"),
    Parameter(Q, "recipient", R),
    Parameter(Q, "text", _),
    Field(S, "share_recipient", R),
    Field(S, "share_status", "active"),
    Field(R, "contact_trusted", "true").

Allow(Q) :- Request(Q, "share", "send_message"),
    Parameter(Q, "recipient", R),
    Parameter(Q, "text", _),
    Field(S, "share_recipient", R),
    Field(S, "share_status", "active"),
    Field(C, "contact_channel", R),
    Field(C, "contact_trusted", "true").

Allow(Q) :- Request(Q, "concierge", "concierge_reply").
Allow(Q) :- Request(Q, "route", "route_agent_reply").

Deny(Q, "p6_duration_over_240") :-
    Request(Q, _, "create_share"),
    Parameter(Q, "duration_min", D),
    D > 240.

Deny(Q, "p6_no_duration_or_stop") :-
    Request(Q, _, "create_share"),
    Parameter(Q, "duration_min", D),
    D <= 0,
    Parameter(Q, "stop_on_arrival", "false").

Deny(Q, "p7_precise_near_sensitive") :-
    Request(Q, "share", "create_share"),
    Parameter(Q, "live_location", "true"),
    Parameter(Q, "precision", P),
    P != "neighborhood",
    Parameter(Q, "protect_sensitive", "false"),
    Field(_, "rider_min_sensitive_distance_m", D),
    D <= 300.

Deny(Q, "p7_precise_near_sensitive_update") :-
    Request(Q, "share", "update_share"),
    Parameter(Q, "share_id", S),
    Field(S, "share_field_live_location", "true"),
    Field(S, "share_precision", P),
    P != "neighborhood",
    Field(S, "share_protect_sensitive", "false"),
    Field(_, "rider_min_sensitive_distance_m", D),
    D <= 300.

Deny(Q, "p19_contact_key") :-
    Request(Q, _, A),
    A != "ask_share_agent",
    Parameter(Q, "request", Req),
    Field(Req, "contact_name", _).

Deny(Q, "p19_contact_name") :-
    Request(Q, _, A),
    A != "ask_share_agent",
    Parameter(Q, "request", Req),
    Field(C, "contact_name", Req).

Deny(Q, "p19_contact_channel") :-
    Request(Q, _, A),
    A != "ask_share_agent",
    Parameter(Q, "request", Req),
    Field(C, "contact_channel", Req).

Deny(Q, "p19_share_id") :-
    Request(Q, _, A),
    A != "ask_share_agent",
    Parameter(Q, "request", Req),
    Field(Req, "share_status", _).
