PrincipalGroup("concierge", "Concierge").
PrincipalGroup("schedule", "Specialist").
PrincipalGroup("transit", "Specialist").
PrincipalGroup("route", "Specialist").
PrincipalGroup("share", "Specialist").
PrincipalGroup("share", "ShareAgent").
PrincipalGroup("app", "AppActor").
Capability("Concierge", "user", "ask_user").
Capability("Concierge", "specialist_request", "ask_schedule_agent").
Capability("Concierge", "specialist_request", "ask_transit_agent").
Capability("Concierge", "specialist_request", "ask_route_agent").
Capability("Concierge", "specialist_request", "ask_share_agent").
Capability("ShareAgent", "share_operations", "create_share").
Capability("ShareAgent", "share_operations", "update_share").
Capability("ShareAgent", "share_operations", "revoke_share").
Capability("ShareAgent", "share_operations", "send_message").
Capability("ShareAgent", "share_operations", "get_contacts").
Capability("ShareAgent", "share_operations", "read_replies").
InitialState("share", "active").
AllowedTransition("share", "update_share", "active", "active").
AllowedTransition("share", "revoke_share", "active", "revoked").
AllowedTransition("share", "arrive", "active", "ended").
AllowedTransition("share", "expire", "active", "expired").

Allow(Q) :- Request(Q, "concierge", A), Capability("Concierge", "specialist_request", A).

Allow(Q) :- Request(Q, "share", "create_share"),
    Parameter(Q, "recipient", R),
    Field(R, "contact_trusted", "true"),
    Parameter(Q, "live_location", _),
    Parameter(Q, "route", _),
    Parameter(Q, "eta", "true"),
    Parameter(Q, "eta_time", E),
    E != "",
    Field(_, "eta_value", E),
    Parameter(Q, "precision", _),
    Parameter(Q, "duration_min", _),
    Parameter(Q, "stop_on_arrival", _),
    Parameter(Q, "message", _),
    Parameter(Q, "hide_places", _),
    Parameter(Q, "protect_sensitive", _),
    Parameter(Q, "channel", _).

