# Ollama server (the GPU PC, reached over Tailscale)
OLLAMA_URL=http://<pc-tailscale-name>:11434
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m

# Default model for all agents
MODEL=gemma4:12b
THINK=false

# Per-agent overrides (optional): MODEL_<AGENT>, THINK_<AGENT>
# AGENT is one of CONCIERGE, SCHEDULE, TRANSIT, ROUTE, SHARE
# MODEL_SCHEDULE=gemma4:12b
# THINK_CONCIERGE=true
